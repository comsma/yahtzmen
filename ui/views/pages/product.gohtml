{{ template "layout" . }}

{{ define "title" }}{{ .Product.Name }} — Yahtzmen{{ end }}

{{ define "content" }}
  <div class="bg-base-100 min-h-screen font-lora">
    <div class="mx-auto max-w-7xl px-4 py-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
        {{/* Image gallery */}}
        <div
          x-data="{ selected: 0 }"
          class="flex flex-col-reverse gap-4 lg:flex-row"
        >
          {{/* Thumbnails */}}
          <div class="flex flex-row gap-2 lg:flex-col">
            {{ range $i, $url := .Product.Images }}
              <button
                @click="selected = {{ $i }}"
                class="aspect-square w-16 overflow-hidden rounded-lg border-2 transition-all"
                :class="selected === {{ $i }} ? 'border-primary' : 'border-base-300 opacity-60 hover:opacity-100'"
              >
                <img
                  src="{{ $url }}"
                  alt=""
                  class="h-full w-full object-cover"
                />
              </button>
            {{ end }}
          </div>

          {{/* Main image */}}
          <div class="relative flex-1 overflow-hidden rounded-2xl bg-base-200">
            {{ range $i, $url := .Product.Images }}
              <img
                x-show="selected === {{ $i }}"
                src="{{ $url }}"
                alt=""
                class="aspect-square w-full object-cover"
              />
            {{ end }}
            {{ if not .Product.Images }}
              <div
                class="flex aspect-square items-center justify-center text-base-content/30"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-24 w-24"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>
            {{ end }}
          </div>
        </div>

        {{/* Product info */}}
        <div class="flex flex-col gap-6">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">
              {{ .Product.Name }}
            </h1>
            <p class="mt-2 text-2xl font-semibold">${{ .Product.Price }}</p>
          </div>

          <p class="text-base-content/80 whitespace-pre-line leading-relaxed">
            {{ .Product.Description }}
          </p>

          <button class="btn btn-primary w-full text-base">Add to Cart</button>

          <div class="divider"></div>

          {{/* Features */}}
          {{ if .Product.Features }}
            <div class="collapse collapse-arrow bg-base-200">
              <input type="checkbox" checked name="features-accordion" />
              <div class="collapse-title font-semibold">Features</div>
              <div class="collapse-content">
                <ul
                  class="list-disc space-y-1 pl-5 text-sm text-base-content/70"
                >
                  {{ range .Product.Features }}
                    <li>{{ . }}</li>
                  {{ end }}
                </ul>
              </div>
            </div>
          {{ end }}

          {{/* Notes */}}
          {{ if .Product.Notes }}
            <div class="collapse collapse-arrow bg-base-200">
              <input type="checkbox" name="notes-accordion" />
              <div class="collapse-title font-semibold">Notes</div>
              <div class="collapse-content">
                <p class="whitespace-pre-line text-sm text-base-content/70">
                  {{ .Product.Notes }}
                </p>
              </div>
            </div>
          {{ end }}

          {{/* Dimensions */}}
          {{ if .Product.Dimensions }}
            <div class="collapse collapse-arrow bg-base-200">
              <input type="checkbox" name="dimensions-accordion" />
              <div class="collapse-title font-semibold">Dimensions</div>
              <div class="collapse-content">
                <p class="whitespace-pre-line text-sm text-base-content/70">
                  {{ .Product.Dimensions }}
                </p>
              </div>
            </div>
          {{ end }}

        </div>
      </div>
    </div>
  </div>
{{ end }}
