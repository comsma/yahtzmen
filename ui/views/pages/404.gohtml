{{ template "layout" . }}

{{ define "title" }}Page Not Found{{ end }}

{{ define "content" }}
  <div class="flex min-h-[80vh] flex-col items-center justify-center text-white">
    <h1 class="text-6xl font-bold">404</h1>
    <p class="mt-4 text-xl">Page not found.</p>
    <a href="/" class="mt-8 underline">Go home</a>
  </div>
{{ end }}
