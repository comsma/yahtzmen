create{{ template "admin" . }}

{{ define "title" }}Products — Admin{{ end }}

{{ define "admin-header" }}
  <h1>Products</h1>
  <a href="/admin/products/new">Add Product</a>
{{ end }}

{{ define "admin-content" }}
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{ range .Products }}
        <tr>
          <td>{{ .Name }}</td>
          <td>{{ .Price }}</td>
          <td>{{ .Stock }}</td>
          <td>
            <a href="/admin/products/{{ .ID }}/edit">Edit</a>
            <form method="POST" action="/admin/products/{{ .ID }}/delete">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      {{ end }}
    </tbody>
  </table>
{{ end }}
