{{ define "nav" }}
  <header class="sticky top-0 z-50 bg-secondary font-lora text-primary py-10">
    {{/* Mobile layout */}}
    <div class="flex flex-col items-center px-4 py-2 gap-8 lg:hidden">
      <div class="flex w-full items-center justify-between">
        <div class="w-7"></div>
        <a href="/">
          <img
            class="h-14 w-14 object-contain"
            src="/static/images/logo.webp"
            alt="Yahtzmen YF logo"
          />
        </a>
        <a href="/cart">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-7 w-7 fill-current"
            viewBox="0 0 24 24"
          >
            <path
              d="M2.25 2.25a.75.75 0 0 0 0 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 0 0-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 0 0 0-1.5H5.378A2.25 2.25 0 0 1 7.5 15h11.218a.75.75 0 0 0 .674-.421 60.358 60.358 0 0 0 2.96-7.228.75.75 0 0 0-.525-.965A60.864 60.864 0 0 0 5.68 4.509l-.232-.867A1.875 1.875 0 0 0 3.636 2.25H2.25zM3.75 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zM16.5 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0z"
            />
          </svg>
        </a>
      </div>
      <div class="flex gap-x-6 pb-2 text-xs font-light">
        <a href="/#product" class="hover:opacity-75">Products</a>
        <a href="/#mission" class="hover:opacity-75">Our Mission</a>
        <a href="/#collaborate" class="hover:opacity-75">Lets Collaborate</a>
      </div>
    </div>

    {{/* Desktop layout */}}
    <div
      class="hidden lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center gap-8 lg:px-8 lg:py-2"
    >
      <div class="flex">
        <a href="/">
          <img
            class="h-12 object-contain"
            src="/static/images/name-logo.webp"
            alt="Yahtzmen"
          />
        </a>
      </div>
      <div class="flex justify-center px-4">
        <a href="/">
          <img
            class="h-14 w-14 object-contain"
            src="/static/images/logo.webp"
            alt="Yahtzmen YF logo"
          />
        </a>
      </div>
      <div class="flex items-center justify-end gap-x-6">
        <a
          href="/#product"
          class="text-sm font-light hover:opacity-75 xl:text-base"
          >Products</a
        >
        <a
          href="/#mission"
          class="text-sm font-light hover:opacity-75 xl:text-base"
          >Our Mission</a
        >
        <a
          href="/#collaborate"
          class="text-sm font-light hover:opacity-75 xl:text-base"
          >Lets Collaborate</a
        >
        <a href="/cart">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-7 w-7 fill-current"
            viewBox="0 0 24 24"
          >
            <path
              d="M2.25 2.25a.75.75 0 0 0 0 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 0 0-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 0 0 0-1.5H5.378A2.25 2.25 0 0 1 7.5 15h11.218a.75.75 0 0 0 .674-.421 60.358 60.358 0 0 0 2.96-7.228.75.75 0 0 0-.525-.965A60.864 60.864 0 0 0 5.68 4.509l-.232-.867A1.875 1.875 0 0 0 3.636 2.25H2.25zM3.75 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zM16.5 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0z"
            />
          </svg>
        </a>
      </div>
    </div>
  </header>
{{ end }}
